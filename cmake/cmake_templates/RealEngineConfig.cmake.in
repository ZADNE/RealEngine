include(CMakeFindDependencyMacro)

# Vulkan
find_dependency(Vulkan REQUIRED COMPONENTS glslc)

# SDL3
find_dependency(SDL3 REQUIRED COMPONENTS SDL3-shared)
find_dependency(SDL3_ttf REQUIRED COMPONENTS SDL3_ttf-shared)

# Spriv-cross
include("${CMAKE_CURRENT_LIST_DIR}/../../spirv_cross_core/cmake/spirv_cross_coreConfig.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../spirv_cross_reflect/cmake/spirv_cross_reflectConfig.cmake")

# bit-7z dependencies / 7-zip
include("${CMAKE_CURRENT_LIST_DIR}/../../bit7z/cmake/FilesystemDetect.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../bit7z/cmake/BuildOptions.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../bit7z/cmake/Dependencies.cmake")

# Runtime artifacts needed by RealEngine
if(WIN32)
    add_library(7z_dll SHARED IMPORTED GLOBAL)
    set_target_properties(7z_dll PROPERTIES
        IMPORTED_LOCATION "${CMAKE_CURRENT_LIST_DIR}/../../../bin/7z.dll"
    )
    list(APPEND runtime_bundled_artifacts 7z_dll)
endif()
set(REALENGINE_RUNTIME_ARTIFACTS # A bit hacky...
    SDL3::SDL3-shared SDL3_ttf::SDL3_ttf-shared ${runtime_bundled_artifacts}
    CACHE INTERNAL ""
)

# Not building from source
set(REALENGINE_BUILDING_FROM_SOURCE FALSE
    CACHE INTERNAL "Whether building RealEngine from source (as opposed to using installed)"
)

# RealEngine targets
include("${CMAKE_CURRENT_LIST_DIR}/RealEngineTargets.cmake")

# CMake functions needed by projects using RealEngine (e.g. add_real_executable)
include("${CMAKE_CURRENT_LIST_DIR}/scripts/RealProject.cmake")